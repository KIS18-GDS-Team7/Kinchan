{
    // リポジトリのパスと、Google Drive 上の置き場所の対応表。ここに書いたものだけを置く。
    // dest は成果物フォルダからの相対パスで、同じ対応表を 2 か所に使う。
    //   成果物/                               : main の最新にある、一致する全ファイル
    //   PR-成果物/#<番号> <タイトル>-成果物/  : main 向けの PR の差分 (削除を除く) のうち、一致するファイル
    // main では main のこのファイルを、PR では PR の head のこのファイルを使う。
    // 対象から外れたファイルは、script が置いたものに限りゴミ箱へ移す。
    // 行頭が // の行はコメント。
    //
    // src : リポジトリのパス。glob 可 (* はディレクトリ内、** は階層をまたぐ)
    // dest: 成果物フォルダ内の相対パス。末尾 / または src が glob ならフォルダ、それ以外はファイル名そのもの
    // convert: "gdoc" = Markdown を Google Docs に変換 / "none" = そのまま置く (既定)
    "entries": [
        {
            "src": "docs/requirements/requirements.md",
            "dest": "要件定義書",
            "convert": "gdoc"
        },
        {
            "src": "docs/usecase/*.md",
            "dest": "02ユースケースドキュメント/",
            "convert": "gdoc"
        },
        {
            "src": "docs/usecase/*.svg",
            "dest": "01ユースケース図/",
            "convert": "none"
        },
        {
            "src": "docs/usecase/*.png",
            "dest": "01ユースケース図/",
            "convert": "none"
        },
        {
            "src": "docs/class/conceptual-class-diagram.*",
            "dest": "03概念クラス図/",
            "convert": "none"
        },
        {
            "src": "docs/screen-transition-diagram/screen_transition_diagram.*",
            "dest": "04画面遷移図/",
            "convert": "none"
        },
        {
            "src": "mock/**",
            "dest": "05画面レイアウト/",
            "convert": "none"
        },
        {
            "src": "docs/sequence-diagram/*.png",
            "dest": "06シーケンス図/",
            "convert": "none"
        },
        {
            "src": "docs/sequence-diagram/*.svg",
            "dest": "06シーケンス図/",
            "convert": "none"
        }
    ]
}
